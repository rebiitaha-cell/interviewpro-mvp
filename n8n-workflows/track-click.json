{
  "name": "InterviewPro – Track Click",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "track-click",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-click",
      "name": "Webhook POST /track-click",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "track-click"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst required = ['countryCode'];\nfor (const field of required) {\n  if (!body[field]) throw new Error(`${field} is required`);\n}\nreturn [{ json: {\n  countryCode: body.countryCode.toUpperCase(),\n  source: body.source || 'unknown',\n  referrer: body.referrer || null\n} }];"
      },
      "id": "validate-click",
      "name": "Validate Click Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/track/click",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "countryCode", "value": "={{ $json.countryCode }}" },
            { "name": "source", "value": "={{ $json.source }}" },
            { "name": "referrer", "value": "={{ $json.referrer }}" }
          ]
        },
        "options": { "timeout": 8000 }
      },
      "id": "record-click",
      "name": "Record Click",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-click",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook POST /track-click": { "main": [[{ "node": "Validate Click Data", "type": "main", "index": 0 }]] },
    "Validate Click Data": { "main": [[{ "node": "Record Click", "type": "main", "index": 0 }]] },
    "Record Click": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["interviewpro", "tracking"],
  "versionId": "1"
}
