{
  "name": "InterviewPro – Track Conversion",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "track-conversion",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-conversion",
      "name": "Webhook POST /track-conversion",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "track-conversion"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst validTypes = ['enrollment', 'application', 'signup', 'contact'];\nif (!body.countryCode) throw new Error('countryCode is required');\nif (!body.type || !validTypes.includes(body.type)) throw new Error(`type must be one of: ${validTypes.join(', ')}`);\nreturn [{ json: {\n  countryCode: body.countryCode.toUpperCase(),\n  type: body.type,\n  clickId: body.clickId || null,\n  value: body.value || null\n} }];"
      },
      "id": "validate-conversion",
      "name": "Validate Conversion Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/track/conversion",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "countryCode", "value": "={{ $json.countryCode }}" },
            { "name": "type", "value": "={{ $json.type }}" },
            { "name": "clickId", "value": "={{ $json.clickId }}" },
            { "name": "value", "value": "={{ $json.value }}" }
          ]
        },
        "options": { "timeout": 8000 }
      },
      "id": "record-conversion",
      "name": "Record Conversion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $env.TELEGRAM_CHAT_ID }}" },
            { "name": "text", "value": "=🎯 New {{ $('Validate Conversion Data').item.json.type }} conversion from {{ $('Validate Conversion Data').item.json.countryCode }}{{ $('Validate Conversion Data').item.json.value ? ' — value: ' + $('Validate Conversion Data').item.json.value : '' }}" }
          ]
        },
        "options": {}
      },
      "id": "notify-conversion",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $('Record Conversion').item.json }}",
        "options": {}
      },
      "id": "respond-conversion",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook POST /track-conversion": { "main": [[{ "node": "Validate Conversion Data", "type": "main", "index": 0 }]] },
    "Validate Conversion Data": { "main": [[{ "node": "Record Conversion", "type": "main", "index": 0 }]] },
    "Record Conversion": { "main": [[{ "node": "Notify Telegram", "type": "main", "index": 0 }]] },
    "Notify Telegram": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["interviewpro", "tracking"],
  "versionId": "1"
}
